# App Setup
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL Database (Drizzle ORM)
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/your_database

# CloudHike.dev Auth (email/password + Google). Only AUTH_URL and AUTH_PUBLISHABLE_KEY are browser-safe.
AUTH_URL=https://cloudhike.dev/api/auth-service/your-project-slug
AUTH_PUBLISHABLE_KEY=pk_your_publishable_key
AUTH_SECRET_KEY=sk_your_secret_key

# Strapi CMS: stores a profile in the Users collection for every signed-up user and their
# headquarters in the `headquarters` collection, and their agents in `agents` (server only).
STRAPI_URL=http://localhost:1337
STRAPI_API_TOKEN=your_strapi_api_token

# ---------- Agent runtime (OpenAI Agents SDK). All server only. ----------
# LLM for agents: openai (default) | anthropic. Anthropic runs Claude through its OpenAI-compatible endpoint;
# hosted web_search is OpenAI-only. OPENAI_API_KEY is still needed for voiceover (TTS) and OpenAI image generation.
AI_PROVIDER=openai
ANTHROPIC_API_KEY=
# Optional Claude defaults (used when AI_PROVIDER=anthropic and an agent has no claude-* model set)
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_ORCHESTRATOR_MODEL=
OPENAI_API_KEY=
# Optional model defaults. Per-agent models are set in each building's AI settings.
OPENAI_DEFAULT_MODEL=
OPENAI_ORCHESTRATOR_MODEL=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_IMAGE_MODEL=gpt-image-1
ORCHESTRATOR_MAX_TURNS=30
TASK_TIMEOUT_SECONDS=900

# Shared agent memory through Strapi's MCP server (Strapi: server.mcp.enabled + memory_* tools).
# STRAPI_MCP_TOKEN is a Strapi *admin* token (Settings → Admin tokens) whose owner can read/create/update Memories.
# Without it, agents use the same memory through the REST API instead.
STRAPI_MCP_TOKEN=
# Same value as MEMORY_SCOPE_SECRET in Strapi's .env (32+ chars): openssl rand -hex 32
MEMORY_SCOPE_SECRET=
# Optional: public base URL for files in Strapi's media library, if different from STRAPI_URL.
STRAPI_PUBLIC_URL=

# ImageKit AI image generation and transformation (generate_image / transform_image tools).
# Same URL endpoint as Strapi's ImageKit upload plugin; results are uploaded to Strapi's media library.
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
# Optional, server only: signs ImageKit URLs. Required when "Restrict unsigned URLs" is on in ImageKit.
IMAGEKIT_PRIVATE_KEY=
# Optional: force the text-to-image provider (imagekit | openai). Default: imagekit when the endpoint is set.
IMAGE_PROVIDER=

# CloudHike.dev background jobs for headquarters tasks. Used only when APP_PUBLIC_URL (or NEXT_PUBLIC_APP_URL)
# is a public address CloudHike can call; otherwise tasks run inside this server. AGENT_RUNNER=inline forces that.
JOBS_API_URL=
JOBS_API_KEY=
JOBS_TIMEOUT_SECONDS=300
APP_PUBLIC_URL=
AGENT_RUNNER=
# Optional: how often the CloudHike Jobs schedule checks pages agents wait on (wait_for_external). Default every
# 5 minutes ("*/5 * * * *", paid plans); CloudHike Free allows every 15 minutes at most ("*/15 * * * *").
WAIT_CHECK_CRON=

# CloudHike.dev Cloud Computer for the agents' `computer` tool (browser, terminal, files). Server only.
# Deploy "Cloud Computer" on the CloudHike project to get these. See docs/cloud-computer.md.
COMPUTERS_API_URL=
COMPUTERS_API_KEY=
# Optional: basic (default) | medium | large
COMPUTER_SIZE=
# Optional: how long an agent waits for the user to sign in or answer, in seconds (default 600)
COMPUTER_USER_WAIT_SECONDS=
# Optional: an agent gives the computer back (and it shuts down) after this many seconds without using it (default 180)
COMPUTER_IDLE_RELEASE_SECONDS=

# Composio: the external accounts users connect on Dashboard → Accounts (Instagram, YouTube, X, LinkedIn, Notion…)
# and the tools agents use with them. Server only. See docs/accounts.md.
COMPOSIO_API_KEY=
# Optional: how often the CloudHike Jobs schedule publishes posts agents scheduled (default "*/5 * * * *";
# CloudHike Free allows every 15 minutes at most). Scheduling needs the JOBS_* settings and a public APP_PUBLIC_URL.
POST_PUBLISH_CRON=
